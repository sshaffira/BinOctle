<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BinOctle: The Cipher Room</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #00ffcc; /* Neon Cyan */
            --primary-glow: rgba(0, 255, 204, 0.6);
            --secondary: #b300ff; /* Neon Purple */
            --bg-dark: #0a0a0f;
            --panel-bg: rgba(15, 20, 30, 0.85);
            --text-main: #e2e8f0;
            --locked-color: #334155;
            --locked-border: #475569;
        }

        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            overflow-x: hidden;
            margin: 0;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(0, 255, 204, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(179, 0, 255, 0.05) 0%, transparent 40%),
                linear-gradient(rgba(10, 10, 15, 0.9), rgba(10, 10, 15, 0.9)),
                url('data:image/svg+xml;base64,');
        }

        .font-mono { font-family: 'Share Tech Mono', monospace; }
        .font-display { font-family: 'Orbitron', sans-serif; }

        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 255, 204, 0.1);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(0, 255, 204, 0.02);
            border-radius: 12px;
        }
        
        .btn-neon {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            box-shadow: 0 0 10px var(--primary-glow), inset 0 0 10px var(--primary-glow);
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
        }
        .btn-neon:hover:not(:disabled) {
            background: var(--primary);
            color: var(--bg-dark);
            box-shadow: 0 0 20px var(--primary-glow), inset 0 0 20px var(--primary-glow);
            text-shadow: none;
        }
        .btn-neon:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
            border-color: #666;
            color: #666;
        }

        .puzzle-board {
            position: relative;
            width: 100%;
            max-width: 480px;
            aspect-ratio: 1 / 1;
            margin: 0 auto;
            background: rgba(0, 0, 0, 0.8);
            border: 2px solid rgba(0, 255, 204, 0.2);
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
        }

        /* MS Word SVG Logo as the hidden image */
        .puzzle-piece {
            position: absolute;
            width: 25%;
            height: 25%;
            background-color: var(--locked-color);
            border: 1px solid var(--locked-border);
            cursor: pointer;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            background-image: none; /* Initially none */
            background-size: 400% 400%; /* Important for 4x4 grid mapping */
            z-index: 2;
        }

        /*
           We construct the SVG data URI for Animal Art (Elephant) to be used as background.
        */
        .puzzle-piece.revealed {
            background-color: transparent;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><rect width="256" height="256" fill="%2314532d"/><circle cx="140" cy="140" r="60" fill="%2394a3b8"/><circle cx="90" cy="120" r="40" fill="%2394a3b8"/><ellipse cx="110" cy="110" rx="30" ry="40" fill="%2364748b"/><path d="M 60 140 Q 40 180 60 210 Q 70 210 65 190 Q 55 160 70 140 Z" fill="%2394a3b8"/><rect x="110" y="180" width="20" height="40" rx="5" fill="%2364748b"/><rect x="160" y="180" width="20" height="40" rx="5" fill="%2364748b"/><rect x="90" y="190" width="20" height="30" rx="5" fill="%2394a3b8"/><rect x="140" y="190" width="20" height="30" rx="5" fill="%2394a3b8"/><circle cx="75" cy="110" r="4" fill="%230f172a"/><path d="M 195 140 Q 210 160 215 180" stroke="%2364748b" stroke-width="4" fill="none"/></svg>');
            border: 1px solid rgba(255,255,255,0.05);
            cursor: default;
            z-index: 1;
            box-shadow: none;
            color: transparent; /* hide text */
        }
        
        .puzzle-piece.revealed .piece-content { display: none; }

        .puzzle-piece.locked:hover {
            background-color: #3f51b5;
            border-color: var(--primary);
            box-shadow: inset 0 0 15px rgba(0, 255, 204, 0.3);
            z-index: 10;
            transform: scale(1.05);
            color: white;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 10px rgba(0, 255, 204, 0.2); }
            50% { box-shadow: 0 0 25px rgba(0, 255, 204, 0.6); }
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px) rotate(-1deg); }
            40%, 80% { transform: translateX(5px) rotate(1deg); }
        }
        .anim-shake { animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both; }

        @keyframes unlockFlash {
            0% { filter: brightness(1) sepia(0); }
            50% { filter: brightness(2) sepia(1) hue-rotate(90deg); box-shadow: 0 0 30px var(--primary); z-index: 20;}
            100% { filter: brightness(1) sepia(0); }
        }
        .anim-unlock { animation: unlockFlash 0.8s ease-out; }
        
        @keyframes finalReveal {
            0% { filter: brightness(1); box-shadow: 0 0 0 transparent;}
            50% { filter: brightness(1.5); box-shadow: 0 0 50px rgba(0, 255, 204, 1); transform: scale(1.02); z-index:50;}
            100% { filter: brightness(1); box-shadow: 0 0 20px rgba(0, 255, 204, 0.5); transform: scale(1); z-index:1;}
        }
        .board-reveal { animation: finalReveal 2s ease-out forwards; border-color: var(--primary); }

        /* Utilities */
        .hidden-ui { display: none !important; opacity: 0; pointer-events: none; }
        .fade-in { animation: fadeIn 0.5s ease-in forwards; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0,255,204,0.3); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0,255,204,0.6); }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-2 sm:p-4 text-sm sm:text-base">

    <div id="screen-start" class="glass-panel w-full max-w-3xl p-8 sm:p-12 text-center transition-all duration-500 relative overflow-hidden">
        <div class="absolute -top-20 -left-20 w-40 h-40 bg-cyan-500/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-20 -right-20 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 flex flex-col items-center">
            <div class="mb-4 text-cyan-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    <path d="M12 15v2"></path>
                </svg>
            </div>
            <h1 class="font-display text-5xl sm:text-7xl font-black mb-2 tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500" style="text-shadow: 0 0 20px rgba(0,255,204,0.2);">
                BinOctle
            </h1>
            <h2 class="font-mono text-xl sm:text-2xl text-cyan-200 tracking-[0.3em] mb-6 border-b border-cyan-500/30 pb-4 inline-block">
                THE CIPHER ROOM
            </h2>
            
            <p class="text-gray-400 max-w-lg mx-auto mb-8 font-medium leading-relaxed">
                "Crack the Numbers. Unlock the Puzzle. Escape the Room."<br><br>
                16 ciphered puzzle pieces are locked inside the room. Solve the number conversion missions to unlock them and reveal the hidden image.
            </p>
            
            <button id="btn-start" class="btn-neon font-display font-bold py-4 px-10 rounded text-xl flex items-center gap-3 group">
