                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                </svg>
                START THE CHALLENGE
            </button>
        </div>
    </div>

    <div id="screen-game" class="hidden-ui w-full max-w-6xl flex-col gap-4 fade-in h-full">
        
        <!-- Header Dashboard -->
        <header class="glass-panel p-4 flex flex-col sm:flex-row justify-between items-center gap-4 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-cyan-900/20 to-purple-900/20 z-0"></div>
            
            <div class="z-10 flex items-center gap-3">
                <div class="p-2 bg-cyan-950 border border-cyan-800 rounded">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00ffcc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="font-display font-bold text-xl text-white tracking-wide leading-none">BINOctle</h1>
                    <span class="font-mono text-xs text-cyan-400 tracking-widest">THE CIPHER ROOM</span>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="z-10 flex gap-4 sm:gap-8 font-mono text-sm border border-gray-700/50 bg-black/40 rounded-lg p-2 px-4 shadow-inner">
                <div class="flex flex-col items-center">
                    <span class="text-gray-500 text-[10px] uppercase">Score</span>
                    <span id="stat-score" class="text-cyan-400 font-bold text-lg">0</span>
                </div>
                <div class="w-px bg-gray-700"></div>
                <div class="flex flex-col items-center">
                    <span class="text-gray-500 text-[10px] uppercase">Attempts</span>
                    <span id="stat-attempts" class="text-white font-bold text-lg">0</span>
                </div>
                <div class="w-px bg-gray-700"></div>
                <div class="flex flex-col items-center">
                    <span class="text-gray-500 text-[10px] uppercase">Hints Used</span>
                    <span id="stat-hints" class="text-orange-400 font-bold text-lg">0</span>
                </div>
            </div>
            
            <div class="z-10 flex gap-2">
                <button id="btn-reset" class="p-2 bg-slate-800 hover:bg-red-900/50 border border-slate-700 hover:border-red-500 text-slate-400 hover:text-red-400 rounded transition-colors" title="Reset Game">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </button>
            </div>
        </header>

        <div class="flex flex-col lg:flex-row gap-6 mt-2 items-start">
            
            <!-- Left: Puzzle Area -->
            <div class="glass-panel w-full lg:w-3/5 p-6 flex flex-col items-center justify-center order-2 lg:order-1 min-h-[500px]">
                
                <div class="w-full max-w-md mb-6">
                    <div class="flex justify-between font-mono text-xs mb-2">
                        <span class="text-gray-400">PUZZLE PROGRESS</span>
                        <span id="progress-text" class="text-cyan-400 font-bold">0 / 16 UNLOCKED</span>
                    </div>
                    <div class="h-2 w-full bg-slate-800 rounded-full overflow-hidden border border-slate-700">
                        <div id="progress-bar" class="h-full bg-cyan-500 shadow-[0_0_10px_#00ffcc] transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>

                <div id="puzzle-board" class="puzzle-board">
                    <!-- Puzzle pieces injected by JS -->
                </div>
            </div>

            <!-- Right: Interactive Panel (Missions, Guessing) -->
            <div class="w-full lg:w-2/5 flex flex-col gap-4 order-1 lg:order-2 h-full">
                
                <!-- Instruction / Status Panel -->
                <div id="panel-status" class="glass-panel p-6">
                    <h3 class="font-display text-lg text-cyan-400 mb-2 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        SYSTEM STATUS
                    </h3>
                    <p class="text-gray-400 text-sm leading-relaxed mb-4">
                        Select a locked puzzle piece from the board to initiate its cipher mission. You must solve all 16 conversions to reveal the hidden image.
                    </p>
                    <div class="grid grid-cols-2 gap-2 font-mono text-xs text-gray-500 bg-black/30 p-3 rounded border border-gray-800">
                        <div>[ DEC &rarr; BIN ]</div>
                        <div>[ DEC &rarr; OCT ]</div>
                        <div>[ BIN &rarr; DEC ]</div>
                        <div>[ OCT &rarr; DEC ]</div>
                    </div>
                </div>

                <!-- Mission Panel (Hidden initially) -->
                <div id="panel-mission" class="glass-panel p-6 border-cyan-500/50 shadow-[0_0_15px_rgba(0,255,204,0.1)] hidden-ui">
                    <div class="flex justify-between items-center mb-4 border-b border-slate-700 pb-2">
                        <h3 class="font-display text-xl text-white flex items-center gap-2">
                            <span class="text-yellow-400">🔐</span> CIPHER MISSION
                        </h3>
                        <span id="lbl-puzzle-id" class="font-mono text-cyan-400 bg-cyan-900/30 px-2 py-1 rounded">PUZZLE #--</span>
                    </div>

                    <div class="bg-black/60 rounded p-4 mb-4 text-center border border-slate-800 relative overflow-hidden">
                        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSIvPjwvc3ZnPg==')] opacity-30"></div>
                        <p class="text-gray-400 text-xs uppercase tracking-widest mb-2 relative z-10">Convert the number:</p>
                        <div id="lbl-question" class="font-mono text-3xl font-bold tracking-wider text-white relative z-10">
                            --<sub class="text-sm text-gray-500">10</sub> &rarr; ?<sub class="text-sm text-gray-500">2</sub>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="block text-xs font-mono text-gray-400 mb-1">Input:</label>
                        <input type="text" id="inp-answer" class="w-full bg-slate-900 border border-slate-600 rounded p-3 text-white font-mono text-lg text-center focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_10px_rgba(0,255,204,0.3)] transition-all" placeholder="Enter answer here" autocomplete="off">
                    </div>

                    <div id="msg-feedback" class="hidden font-bold text-center text-sm p-2 rounded mb-4 font-mono"></div>
                    
                    <div id="box-hint" class="hidden bg-orange-950/30 border border-orange-500/30 p-3 rounded mb-4">
                        <p class="text-orange-400 text-xs font-bold mb-1">💡 HINT:</p>
                        <p id="lbl-hint" class="text-orange-200 text-sm leading-snug"></p>
                    </div>

                    <div class="flex gap-2">
                        <button id="btn-hint" class="w-1/3 bg-slate-800 hover:bg-slate-700 text-white font-mono text-sm py-2 rounded border border-slate-600 transition-colors flex justify-center items-center gap-1">
                            💡 HINT
                        </button>
                        <button id="btn-submit" class="w-2/3 bg-cyan-600 hover:bg-cyan-500 text-white font-display font-bold py-2 rounded shadow-[0_0_10px_rgba(0,255,204,0.4)] transition-colors">
                            SUBMIT ANSWER
                        </button>
                    </div>
                </div>

                <!-- Final Guess Panel (Hidden initially) -->
                <div id="panel-guess" class="glass-panel p-6 border-purple-500/50 shadow-[0_0_20px_rgba(179,0,255,0.2)] hidden-ui">
                    <h3 class="font-display text-2xl text-purple-400 mb-2 text-center">🕵️ FINAL CHALLENGE</h3>
                    <p class="text-gray-300 text-center mb-6 text-sm">You have successfully reconstructed the image. Based on its shape and color, what animal is this?</p>
                    
                    <input type="text" id="inp-guess" class="w-full bg-slate-900 border border-purple-500/50 rounded p-4 text-white font-mono text-xl text-center focus:outline-none focus:border-purple-400 focus:shadow-[0_0_15px_rgba(179,0,255,0.4)] transition-all mb-4" placeholder="Type your answer...">
                    
                    <div id="msg-guess-feedback" class="hidden text-center text-sm p-2 rounded mb-4 font-bold"></div>

                    <button id="btn-guess" class="w-full bg-purple-600 hover:bg-purple-500 text-white font-display font-bold py-4 rounded text-lg shadow-[0_0_15px_rgba(179,0,255,0.5)] transition-colors flex justify-center items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        SUBMIT GUESS
