                🎉 CIPHER ROOM CLEARED! 🎉
            </h2>
            <p class="text-gray-300 mb-8">Congratulations! You cracked all 16 number ciphers and revealed the hidden image.</p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8 font-mono">
                <div class="bg-black/50 p-4 rounded border border-gray-800">
                    <div class="text-xs text-gray-500 uppercase">Final Score</div>
                    <div id="win-score" class="text-2xl text-green-400 font-bold">0</div>
                </div>
                <div class="bg-black/50 p-4 rounded border border-gray-800">
                    <div class="text-xs text-gray-500 uppercase">Unlocked</div>
                    <div class="text-2xl text-cyan-400 font-bold">16/16</div>
                </div>
                <div class="bg-black/50 p-4 rounded border border-gray-800">
                    <div class="text-xs text-gray-500 uppercase">Attempts</div>
                    <div id="win-attempts" class="text-2xl text-white font-bold">0</div>
                </div>
                <div class="bg-black/50 p-4 rounded border border-gray-800">
                    <div class="text-xs text-gray-500 uppercase">Hints Used</div>
                    <div id="win-hints" class="text-2xl text-orange-400 font-bold">0</div>
                </div>
            </div>

            <p class="text-sm italic text-gray-400 mb-6 border-l-4 border-primary pl-4 text-left bg-primary/10 p-2 rounded-r">
                "You used logical thinking, pattern recognition, decomposition, and systematic problem solving to escape the Cipher Room."
            </p>

            <div class="text-left mb-8">
                <h3 class="font-display text-xl text-white mb-4 border-b border-gray-700 pb-2">WHAT DID YOU PRACTICE?</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-slate-800/50 p-3 rounded">
                        <div class="text-cyan-400 font-bold text-sm mb-1 flex gap-2"><span>🔢</span> Number Systems</div>
                        <div class="text-xs text-gray-400">Mengonversi bilangan antara desimal, biner, dan oktal.</div>
                    </div>
                    <div class="bg-slate-800/50 p-3 rounded">
                        <div class="text-purple-400 font-bold text-sm mb-1 flex gap-2"><span>🧩</span> Decomposition</div>
                        <div class="text-xs text-gray-400">Memecah gambar besar menjadi 16 bagian kecil.</div>
                    </div>
                    <div class="bg-slate-800/50 p-3 rounded">
                        <div class="text-green-400 font-bold text-sm mb-1 flex gap-2"><span>🔍</span> Pattern Recognition</div>
                        <div class="text-xs text-gray-400">Mengenali pola dalam sistem bilangan saat pembagian berulang.</div>
                    </div>
                    <div class="bg-slate-800/50 p-3 rounded">
                        <div class="text-yellow-400 font-bold text-sm mb-1 flex gap-2"><span>⚙️</span> Algorithmic Thinking</div>
                        <div class="text-xs text-gray-400">Mengikuti langkah sistematis untuk mendapatkan jawaban.</div>
                    </div>
                </div>
            </div>

            <button id="btn-play-again" class="btn-neon font-display font-bold py-3 px-8 rounded text-lg inline-flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
                PLAY AGAIN
            </button>
        </div>
    </div>

    <script>
        // Data Structure for the 16 fixed questions based on prompt requirements
        const MISSIONS = [
            { id: 1, type: 'dec2bin', q: 13, ans: '1101', baseQ: 10, baseA: 2, hint: "Bagi bilangan dengan 2 secara berulang. Catat setiap sisa pembagian dan baca sisa dari bawah ke atas." },
            { id: 2, type: 'dec2bin', q: 25, ans: '11001', baseQ: 10, baseA: 2, hint: "Bagi bilangan dengan 2 secara berulang. Catat setiap sisa pembagian dan baca sisa dari bawah ke atas." },
            { id: 3, type: 'dec2bin', q: 42, ans: '101010', baseQ: 10, baseA: 2, hint: "Bagi bilangan dengan 2 secara berulang. Catat setiap sisa pembagian dan baca sisa dari bawah ke atas." },
            { id: 4, type: 'dec2bin', q: 57, ans: '111001', baseQ: 10, baseA: 2, hint: "Bagi bilangan dengan 2 secara berulang. Catat setiap sisa pembagian dan baca sisa dari bawah ke atas." },
            { id: 5, type: 'dec2oct', q: 18, ans: '22', baseQ: 10, baseA: 8, hint: "Bagi bilangan dengan 8 secara berulang. Catat sisa pembagian dan baca dari bawah ke atas." },
            { id: 6, type: 'dec2oct', q: 27, ans: '33', baseQ: 10, baseA: 8, hint: "Bagi bilangan dengan 8 secara berulang. Catat sisa pembagian dan baca dari bawah ke atas." },
            { id: 7, type: 'dec2oct', q: 45, ans: '55', baseQ: 10, baseA: 8, hint: "Bagi bilangan dengan 8 secara berulang. Catat sisa pembagian dan baca dari bawah ke atas." },
            { id: 8, type: 'dec2oct', q: 72, ans: '110', baseQ: 10, baseA: 8, hint: "Bagi bilangan dengan 8 secara berulang. Catat sisa pembagian dan baca dari bawah ke atas." },
            { id: 9, type: 'bin2dec', q: '1011', ans: '11', baseQ: 2, baseA: 10, hint: "Gunakan nilai tempat 2⁰, 2¹, 2², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 10, type: 'bin2dec', q: '11010', ans: '26', baseQ: 2, baseA: 10, hint: "Gunakan nilai tempat 2⁰, 2¹, 2², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 11, type: 'bin2dec', q: '100101', ans: '37', baseQ: 2, baseA: 10, hint: "Gunakan nilai tempat 2⁰, 2¹, 2², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 12, type: 'bin2dec', q: '111011', ans: '59', baseQ: 2, baseA: 10, hint: "Gunakan nilai tempat 2⁰, 2¹, 2², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 13, type: 'oct2dec', q: '14', ans: '12', baseQ: 8, baseA: 10, hint: "Gunakan nilai tempat 8⁰, 8¹, 8², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 14, type: 'oct2dec', q: '25', ans: '21', baseQ: 8, baseA: 10, hint: "Gunakan nilai tempat 8⁰, 8¹, 8², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 15, type: 'oct2dec', q: '47', ans: '39', baseQ: 8, baseA: 10, hint: "Gunakan nilai tempat 8⁰, 8¹, 8², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." },
            { id: 16, type: 'oct2dec', q: '63', ans: '51', baseQ: 8, baseA: 10, hint: "Gunakan nilai tempat 8⁰, 8¹, 8², dan seterusnya. Kalikan setiap digit dengan nilai tempatnya lalu jumlahkan." }
        ];

        // Valid guess answers (case insensitive handled in code)
        const VALID_GUESSES = ['gajah', 'elephant', 'hewan gajah'];

        const GRID_SIZE = 4;
        const TOTAL_PIECES = 16;

        let state = {
            score: 0,
            attempts: 0,
            hintsUsed: 0,
            unlockedCount: 0,
            activePieceIndex: null, // Index in the shuffled array (0-15)
            pieces: [], // Will hold objects: { id (1-16), element, targetRow, targetCol, currentRow, currentCol, locked, usedHint }
            gamePhase: 'start' // start, playing, guessing, ended
        };

        // DOM Elements mapping
        const els = {
            screenStart: document.getElementById('screen-start'),
            screenGame: document.getElementById('screen-game'),
            board: document.getElementById('puzzle-board'),
            
            // Stats
            statScore: document.getElementById('stat-score'),
            statAttempts: document.getElementById('stat-attempts'),
            statHints: document.getElementById('stat-hints'),
            progText: document.getElementById('progress-text'),
            progBar: document.getElementById('progress-bar'),
            
            // Panels
            panelStatus: document.getElementById('panel-status'),
            panelMission: document.getElementById('panel-mission'),
            panelGuess: document.getElementById('panel-guess'),
            modalWin: document.getElementById('modal-win'),
            
            // Mission UI
            lblPid: document.getElementById('lbl-puzzle-id'),
            lblQ: document.getElementById('lbl-question'),
            inpAns: document.getElementById('inp-answer'),
            btnSub: document.getElementById('btn-submit'),
            btnHint: document.getElementById('btn-hint'),
            boxHint: document.getElementById('box-hint'),
            lblHint: document.getElementById('lbl-hint'),
            msgFbk: document.getElementById('msg-feedback'),
            
            // Guess UI
            inpGuess: document.getElementById('inp-guess'),
            btnGuess: document.getElementById('btn-guess'),
            msgGuessFbk: document.getElementById('msg-guess-feedback')
        };

        function shuffleArray(array) {
            let curId = array.length;
            while (0 !== curId) {
                let randId = Math.floor(Math.random() * curId);
                curId -= 1;
                let tmp = array[curId];
                array[curId] = array[randId];
                array[randId] = tmp;
            }
            return array;
        }

        function initGame() {
            // Reset state
            state = {
                score: 0,
                attempts: 0,
                hintsUsed: 0,
                unlockedCount: 0,
                activePieceIndex: null,
                pieces: [],
                gamePhase: 'playing'
            };
            
            updateStatsUI();
            els.board.innerHTML = '';
            els.board.classList.remove('board-reveal');
            
            showPanel('status');
            els.inpGuess.value = '';
            hideFeedback(els.msgGuessFbk);

            // Generate positions
            let positions = [];
            for(let r=0; r<GRID_SIZE; r++) {
                for(let c=0; c<GRID_SIZE; c++) {
                    positions.push({r, c});
                }
            }
            
            // Shuffle starting positions to ensure pieces are scrambled initially
            let scrambledPositions = shuffleArray([...positions]);
            
            // Assign missions (1 to 16) to the grid target positions
            // However, the prompt says "urutan puzzle yang ditampilkan kepada pemain harus diacak"
            // We map target positions to IDs, then shuffle their starting visual places.
            for (let i = 0; i < TOTAL_PIECES; i++) {
                const targetPos = positions[i];
                const startPos = scrambledPositions[i];
                
                const pieceObj = {
                    index: i,
                    missionId: i + 1, // 1 to 16 mapped directly to target positions
                    targetRow: targetPos.r,
                    targetCol: targetPos.c,
                    currentRow: startPos.r,
                    currentCol: startPos.c,
                    locked: true,
                    usedHint: false
                };

                // Create DOM Element
                const el = document.createElement('div');
                el.className = 'puzzle-piece locked';
                // Set initial scrambled position
                el.style.top = `${startPos.r * 25}%`;
                el.style.left = `${startPos.c * 25}%`;
                
                // Set background position based on TARGET to form image when revealed
                // bg position percentage formula: pos * (100 / (grid - 1))
                const bgX = targetPos.c * (100 / (GRID_SIZE - 1));
                const bgY = targetPos.r * (100 / (GRID_SIZE - 1));
                el.style.backgroundPosition = `${bgX}% ${bgY}%`;

                // Inner content (Lock and Number)
                el.innerHTML = `
                    <div class="piece-content flex flex-col items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1 opacity-70"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <span class="font-mono font-bold text-lg">#${String(pieceObj.missionId).padStart(2, '0')}</span>
                    </div>
                `;

                // Event listener
                el.addEventListener('click', () => handlePieceClick(i));
                
                els.board.appendChild(el);
                pieceObj.element = el;
                state.pieces.push(pieceObj);
            }
        }

        function handlePieceClick(index) {
            const piece = state.pieces[index];
            if (!piece.locked || state.gamePhase !== 'playing') return;

            state.activePieceIndex = index;
            const missionData = MISSIONS.find(m => m.id === piece.missionId);

            // Populate Mission UI
            els.lblPid.textContent = `PUZZLE #${piece.missionId}`;
            els.lblQ.innerHTML = `${missionData.q}<sub class="text-sm text-gray-500">${missionData.baseQ}</sub> &rarr; ?<sub class="text-sm text-gray-500">${missionData.baseA}</sub>`;
            els.lblHint.textContent = missionData.hint;
            
            // Reset form states
            els.inpAns.value = '';
            els.inpAns.className = "w-full bg-slate-900 border border-slate-600 rounded p-3 text-white font-mono text-lg text-center focus:outline-none focus:border-cyan-400 focus:shadow-[0_0_10px_rgba(0,255,204,0.3)] transition-all";
            
            hideFeedback(els.msgFbk);
            els.boxHint.classList.add('hidden');
            
            els.btnHint.disabled = false;
            els.btnHint.classList.remove('opacity-50', 'cursor-not-allowed');

            showPanel('mission');
            
            // Highlight active piece on board
            state.pieces.forEach(p => p.element.classList.remove('border-cyan-400', 'shadow-[0_0_15px_rgba(0,255,204,0.5)]'));
            piece.element.classList.add('border-cyan-400', 'shadow-[0_0_15px_rgba(0,255,204,0.5)]');

            setTimeout(() => els.inpAns.focus(), 100);
        }

        function submitAnswer() {
            if (state.activePieceIndex === null) return;
            const piece = state.pieces[state.activePieceIndex];
            const missionData = MISSIONS.find(m => m.id === piece.missionId);
            const userAnswer = els.inpAns.value.trim().toUpperCase();

            if (!userAnswer) return;

            state.attempts++;
            
            if (userAnswer === String(missionData.ans).toUpperCase()) {
                // Correct
                handleCorrect(piece);
            } else {
                // Incorrect
                handleIncorrect();
            }
            updateStatsUI();
        }

        function handleCorrect(piece) {
            // UI Feedback
            els.inpAns.classList.replace('border-slate-600', 'border-green-500');
            els.inpAns.classList.replace('focus:border-cyan-400', 'focus:border-green-400');
            showFeedback(els.msgFbk, "🎉 CORRECT! Cipher cracked! Puzzle unlocked.", 'success');
            
            // Update logic
            piece.locked = false;
            state.unlockedCount++;
            
            const points = piece.usedHint ? 50 : 100;
            state.score += points;

            // Visual update piece
            piece.element.classList.remove('locked', 'border-cyan-400', 'shadow-[0_0_15px_rgba(0,255,204,0.5)]');
            piece.element.classList.add('revealed', 'anim-unlock');
            
            // Move to target position
            piece.element.style.top = `${piece.targetRow * 25}%`;
            piece.element.style.left = `${piece.targetCol * 25}%`;

            els.btnSub.disabled = true;

            setTimeout(() => {
                piece.element.classList.remove('anim-unlock');
                els.btnSub.disabled = false;
                checkProgress();
            }, 1000);
        }

        function handleIncorrect() {
            els.inpAns.classList.add('border-red-500');
            showFeedback(els.msgFbk, "❌ INCORRECT. The cipher is still locked. Check your calculation and try again.", 'error');
            
            // Shake panel
            els.panelMission.classList.remove('anim-shake');
            void els.panelMission.offsetWidth; // trigger reflow
            els.panelMission.classList.add('anim-shake');

            els.inpAns.focus();
            els.inpAns.select();
        }

        function useHint() {
            if (state.activePieceIndex === null) return;
            const piece = state.pieces[state.activePieceIndex];
            
            if (piece.usedHint) return;
            
            piece.usedHint = true;
            state.hintsUsed++;
            updateStatsUI();

            els.boxHint.classList.remove('hidden');
            els.btnHint.disabled = true;
            els.btnHint.classList.add('opacity-50', 'cursor-not-allowed');
            
            // Focus back to input
            els.inpAns.focus();
        }

        function checkProgress() {
            if (state.unlockedCount === TOTAL_PIECES) {
                // All pieces unlocked
                state.gamePhase = 'guessing';
                state.score += 500; // Bonus
                updateStatsUI();

                // Dramatize board reveal
                els.board.classList.add('board-reveal');
                showPanel('status'); // hide mission panel temporarily
                
                els.panelStatus.innerHTML = `
                    <h3 class="font-display text-2xl text-green-400 mb-2 text-center">🔓 ALL CIPHERS CRACKED!</h3>
                    <p class="text-white text-center font-bold">THE HIDDEN IMAGE HAS BEEN REVEALED!</p>
                `;

                setTimeout(() => {
                    showPanel('guess');
                    setTimeout(() => els.inpGuess.focus(), 100);
                }, 2500);

            } else {
                showPanel('status');
                state.activePieceIndex = null;
            }
        }

        function checkGuess() {
            if (state.gamePhase !== 'guessing') return;
            
            const guess = els.inpGuess.value.trim().toLowerCase();
            if (!guess) return;

            let isCorrect = VALID_GUESSES.some(valid => guess === valid || guess.includes(valid));

            if (isCorrect) {
                showFeedback(els.msgGuessFbk, "Tepat sekali! Mengakses sistem pusat...", 'success');
                state.gamePhase = 'ended';
                setTimeout(showWinScreen, 1000);
            } else {
                showFeedback(els.msgGuessFbk, "Belum tepat! 🤔 Coba perhatikan kembali gambar dan pikirkan konsep yang berkaitan dengan pemecahan masalah secara sistematis.", 'error');
                els.panelGuess.classList.add('anim-shake');
                setTimeout(() => els.panelGuess.classList.remove('anim-shake'), 500);
            }
        }

        function showWinScreen() {
            document.getElementById('win-score').textContent = state.score;
            document.getElementById('win-attempts').textContent = state.attempts;
            document.getElementById('win-hints').textContent = state.hintsUsed;
            
            els.modalWin.classList.remove('hidden-ui');
            els.modalWin.classList.add('fade-in');
        }

        function updateStatsUI() {
            els.statScore.textContent = state.score;
            els.statAttempts.textContent = state.attempts;
            els.statHints.textContent = state.hintsUsed;
            
            els.progText.textContent = `${state.unlockedCount} / 16 UNLOCKED`;
            const pct = (state.unlockedCount / TOTAL_PIECES) * 100;
            els.progBar.style.width = `${pct}%`;
        }

        function showPanel(panelName) {
            els.panelStatus.classList.add('hidden-ui');
            els.panelMission.classList.add('hidden-ui');
            els.panelGuess.classList.add('hidden-ui');
            
            if(panelName === 'status') els.panelStatus.classList.remove('hidden-ui');
            if(panelName === 'mission') els.panelMission.classList.remove('hidden-ui');
            if(panelName === 'guess') els.panelGuess.classList.remove('hidden-ui');
        }

        function showFeedback(el, msg, type) {
            el.textContent = msg;
            el.className = 'font-bold text-center text-sm p-2 rounded mb-4 font-mono block';
            if (type === 'success') {
                el.classList.add('bg-green-900/40', 'text-green-400', 'border', 'border-green-500/50');
            } else {
                el.classList.add('bg-red-900/40', 'text-red-400', 'border', 'border-red-500/50');
            }
        }
        function hideFeedback(el) {
            el.classList.add('hidden');
            el.className = 'hidden font-bold text-center text-sm p-2 rounded mb-4 font-mono';
        }

        // Attach Events
        document.getElementById('btn-start').addEventListener('click', () => {
            els.screenStart.classList.add('hidden-ui');
            els.screenGame.classList.remove('hidden-ui');
            initGame();
        });

        document.getElementById('btn-reset').addEventListener('click', () => {
            if(confirm('Are you sure you want to reset the Cipher Room? All progress will be lost.')) {
                initGame();
                // Restore status panel original text if it was modified by end game sequence
                els.panelStatus.innerHTML = `
                    <h3 class="font-display text-lg text-cyan-400 mb-2 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                        SYSTEM STATUS
                    </h3>
                    <p class="text-gray-400 text-sm leading-relaxed mb-4">
                        Select a locked puzzle piece from the board to initiate its cipher mission. You must solve all 16 conversions to reveal the hidden image.
                    </p>
                    <div class="grid grid-cols-2 gap-2 font-mono text-xs text-gray-500 bg-black/30 p-3 rounded border border-gray-800">
                        <div>[ DEC &rarr; BIN ]</div>
                        <div>[ DEC &rarr; OCT ]</div>
                        <div>[ BIN &rarr; DEC ]</div>
                        <div>[ OCT &rarr; DEC ]</div>
                    </div>
                `;
            }
        });

        els.btnSub.addEventListener('click', submitAnswer);
        els.inpAns.addEventListener('keypress', e => { if (e.key === 'Enter') submitAnswer(); });
        els.btnHint.addEventListener('click', useHint);
        
        els.btnGuess.addEventListener('click', checkGuess);
        els.inpGuess.addEventListener('keypress', e => { if (e.key === 'Enter') checkGuess(); });

        document.getElementById('btn-play-again').addEventListener('click', () => {
            els.modalWin.classList.add('hidden-ui');
            els.screenGame.classList.add('hidden-ui');
            els.screenStart.classList.remove('hidden-ui');
        });

    </script>
</body>
</html>
